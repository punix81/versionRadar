# VersionRadar credentials and settings — EXAMPLE ONLY.
#
# Copy this file outside the repository and fill in real values there:
#   mkdir -p ~/.config/opencode && chmod 700 ~/.config/opencode
#   cp .env.example ~/.config/opencode/versionRadar.env
#   chmod 600 ~/.config/opencode/versionRadar.env
#
# The MCP server and the CLI scripts read VERSIONRADAR_ENV_FILE
# (default: ~/.config/opencode/versionRadar.env).
# Never commit the real file, never paste its values in a chat or an issue.

# Azure DevOps
AZUREDEVOPS_USER=<your-user>
AZUREDEVOPS_TOKEN=<azure-devops-personal-access-token>
# Base URL of your Azure DevOps instance (required for on-premise installations)
AZUREDEVOPS_BASE_URL=https://dev.azure.com
# Only for repositories whose "collection" is DefaultCollection18
AZUREDEVOPS_TOKEN_DEFAULTCOLLECTION18=

# Bitbucket Server
BITBUCKET_USER=<your-user>
BITBUCKET_TOKEN=<bitbucket-http-access-token>
BITBUCKET_BASE_URL=https://bitbucket.example.internal
BITBUCKET_AUTH_SCHEME=bearer

# Script settings
REQUEST_TIMEOUT_MS=30000
DATE_LOCALE=fr-CH
# Optional DNS workaround: {"host.name":"10.0.0.1"}
HOST_IP_OVERRIDES=

# TLS: validation is enabled by default.
# Trust internal CAs with a PEM bundle:
VERSIONRADAR_CA_FILE=
# Escape hatch only, never enable by default:
VERSIONRADAR_TLS_INSECURE=0
